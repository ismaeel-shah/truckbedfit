{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "truckbedfit",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-05-24",
  "compatibility_flags": ["nodejs_compat"],
  // Without this, esbuild's keepNames wraps functions in __name(), which breaks
  // inline scripts (next-themes) in the browser: "ReferenceError: __name is not defined".
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Custom domains: Cloudflare creates the DNS records and certificates. The middleware
  // 301-redirects www to the bare domain (the canonical host).
  "routes": [
    { "pattern": "truckbedfit.com", "custom_domain": true },
    { "pattern": "www.truckbedfit.com", "custom_domain": true }
  ],
  // Non-secret runtime config. Secrets (NEXTAUTH_SECRET, RESEND_API_KEY, CONTACT_EMAIL)
  // are set with `npx wrangler secret put <NAME>` — see README.
  // R2_PUBLIC_URL is the bucket's custom domain (R2 → truckbedfit-uploads → Settings → Custom Domains).
  "vars": {
    "R2_PUBLIC_URL": "https://media.truckbedfit.com",
    "NEXTAUTH_URL": "https://truckbedfit.com",
    "RESEND_FROM": "TruckBedFit <noreply@truckbedfit.com>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "truckbedfit",
      "database_id": "61a057b7-d049-41c8-905e-e46a28097e53",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "truckbedfit-uploads"
    }
  ]
}
