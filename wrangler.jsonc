{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "homedeskessentials",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-05-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "homedeskessentials",
      "database_id": "bb472943-03f8-4efb-9736-1517bde30374"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "homedeskessentials-media"
    }
  ]
}
