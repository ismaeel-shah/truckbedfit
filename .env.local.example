# Local development only (`npm run dev`). Production values live in wrangler.jsonc
# "vars" and in Worker secrets — see README.

# NextAuth — generate a fresh secret, never reuse another site's:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=your-long-random-secret-key-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# Cloudflare R2
R2_PUBLIC_URL=https://media.truckbedfit.com

# Site
NEXT_PUBLIC_SITE_URL=https://truckbedfit.com
NEXT_PUBLIC_SITE_NAME=TruckBedFit

# Email (Resend)
RESEND_API_KEY=re_your_api_key
RESEND_FROM="TruckBedFit <noreply@truckbedfit.com>"
CONTACT_EMAIL=you@truckbedfit.com
