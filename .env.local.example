# MongoDB (used only for migration/export until D1 cutover)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/worknest

# NextAuth
NEXTAUTH_SECRET=your-long-random-secret-key-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# Cloudinary (temporary fallback during R2 migration)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Cloudflare R2
R2_PUBLIC_URL=https://media.yourdomain.com

# Site
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_NAME=WorkNest

# Amazon Associates
AMAZON_ASSOCIATE_TAG=yourtag-20

# Email (Resend)
RESEND_API_KEY=re_your_api_key
RESEND_FROM="WorkNest <noreply@yourdomain.com>"
CONTACT_EMAIL=you@yourdomain.com
