# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/worknest

# NextAuth
NEXTAUTH_SECRET=your-long-random-secret-key-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Site
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_NAME=WorkNest

# Amazon Associates
AMAZON_ASSOCIATE_TAG=yourtag-20

# Email (for forgot password) — Gmail example
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-gmail@gmail.com
EMAIL_SERVER_PASSWORD=your-app-password
EMAIL_FROM="WorkNest <your-gmail@gmail.com>"
