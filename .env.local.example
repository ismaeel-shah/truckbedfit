# Local development only (`npm run dev`). Production values live in wrangler.jsonc
# "vars" and in Worker secrets — see README.

# NextAuth — generate a fresh secret, never reuse another site's:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=your-long-random-secret-key-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# Cloudflare R2
R2_PUBLIC_URL=https://media.truckbedfit.com

# Site
NEXT_PUBLIC_SITE_URL=https://truckbedfit.com
NEXT_PUBLIC_SITE_NAME=TruckBedFit

# Amazon Associates tracking ID, added to every product link as ?tag=…
NEXT_PUBLIC_AMAZON_TAG=

# Amazon Creators API (Associates Central → Tools → Creators API). Optional: without them product
# cards simply have no image. Production uses `wrangler secret put` for the ID and secret.
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
# 3.1 = North America (default), 3.2 = Europe, 3.3 = Far East
AMAZON_CREDENTIAL_VERSION=3.1

# Email (Resend)
RESEND_API_KEY=re_your_api_key
RESEND_FROM="TruckBedFit <noreply@truckbedfit.com>"
CONTACT_EMAIL=you@truckbedfit.com
