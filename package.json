{
  "name": "truckbedfit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build && npm run cf:sync-assets",
    "cf:sync-assets": "ts-node --project tsconfig.scripts.json scripts/sync-open-next-assets.ts",
    "cf:preview": "npm run cf:build && wrangler dev",
    "cf:deploy": "npm run cf:build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply truckbedfit --local",
    "db:migrate:remote": "wrangler d1 migrations apply truckbedfit --remote",
    "db:seed-placeholders:local": "wrangler d1 execute truckbedfit --local --file=scripts/seed-placeholders.sql",
    "db:remove-placeholders:local": "wrangler d1 execute truckbedfit --local --file=scripts/remove-placeholders.sql",
    "admin:create": "ts-node --project tsconfig.scripts.json scripts/create-admin.ts",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@opennextjs/cloudflare": "^1.14.10",
    "@tiptap/extension-character-count": "^3.22.3",
    "@tiptap/extension-color": "^3.22.3",
    "@tiptap/extension-highlight": "^3.22.3",
    "@tiptap/extension-image": "^3.22.3",
    "@tiptap/extension-link": "^3.22.3",
    "@tiptap/extension-placeholder": "^3.22.3",
    "@tiptap/extension-table": "^3.22.3",
    "@tiptap/extension-text-align": "^3.22.3",
    "@tiptap/extension-text-style": "^3.22.3",
    "@tiptap/extension-underline": "^3.22.3",
    "@tiptap/react": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.3",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.7.0",
    "next": "14.2.35",
    "next-auth": "^4.24.13",
    "next-themes": "^0.4.6",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.72.1",
    "react-hot-toast": "^2.6.0",
    "resend": "^6.12.3",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcryptjs": "^2.4.6",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "dotenv": "^17.4.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "js-beautify": "^1.15.4",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "wrangler": "^4.94.0"
  }
}
